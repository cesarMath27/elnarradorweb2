# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` ni claves reales al repositorio.

# --- Supabase (obligatorias) ---
# URL del proyecto de Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon/publishable). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service-role. SOLO servidor: salta RLS. Se usa en los uploads del
# panel /admin y en la migración de WordPress. Jamás exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
# URL pública del sitio. Se usa para metadata, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://elnarradordemexico.com

# --- Migración de WordPress (opcionales si no migras contenido) ---
# Endpoint REST del WordPress de origen, p.ej. https://misitio.com/wp-json/wp/v2
WORDPRESS_API_URL=

# Secreto que protege POST /api/migrate (header x-migration-key)
MIGRATION_SECRET_KEY=

# --- Admin (opcional, legado) ---
# Fallback: si un usuario autenticado no está en la tabla admin_users,
# se le permite entrar al panel solo si su email coincide con este.
ADMIN_EMAIL=
