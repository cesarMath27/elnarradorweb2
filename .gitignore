# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# npm pack tarballs
*.tgz

# cloudflare build output
/.open-next/
/.vercel/

# deployment artifacts (generated, never edit by hand)
/deploy/
/deploy-pages/
/deploy_me/

# ───── Versión PHP / Neubox ─────
# Config con credenciales reales (se crea en el servidor a partir de config.example.php)
/public_html/config.php
# Archivos subidos por el panel (no versionar el contenido, sí las carpetas)
/public_html/uploads/news/*
/public_html/uploads/magazines/*
!/public_html/uploads/news/.gitkeep
!/public_html/uploads/magazines/.gitkeep
!/public_html/uploads/.htaccess
