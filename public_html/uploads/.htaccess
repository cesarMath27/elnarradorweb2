# Carpeta de subidas: servir solo como archivos estáticos, NUNCA ejecutar código.
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .pht
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pht|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
Options -ExecCGI
